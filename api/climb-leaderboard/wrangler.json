{
  "name": "alphacity-climb-leaderboard",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {"ALLOWED_ORIGINS": "https://alphacity.tech,https://www.alphacity.tech"},
  "d1_databases": [{"binding": "DB", "database_name": "alphacity-climb-leaderboard", "database_id": "00000000-0000-0000-0000-000000000000"}],
  "ratelimits": [
    {"name": "AUTH_LIMITER", "namespace_id": "1001", "simple": {"limit": 12, "period": 60}},
    {"name": "API_LIMITER", "namespace_id": "1002", "simple": {"limit": 120, "period": 60}}
  ],
  "triggers": {"crons": ["17 4 * * *"]}
}
